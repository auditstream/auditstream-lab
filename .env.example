# Local disposable Docker defaults (copy to .env to override; never commit real secrets)
# Note: APP_USER_PASSWORD must not contain double quotes (") due to PgBouncer userlist.txt syntax.
PG_VERSION=19
PG_PORT=5432
PGBOUNCER_PORT=6432
PG_ADMIN_PASSWORD=postgres_dev_password
APP_USER_PASSWORD=app_dev_password
HONO_PORT=3101
PRISMA_PORT=3102

# Optional artifact & registry overrides (honored by bootstrap.sh; CLI overrides also honored by smoke-interactive.sh and soak/run.sh)
# AUDITSTREAM_BIN=/path/to/auditstream/target/release/auditstream
# AUDITSTREAM_JS_TGZ_DIR=/path/to/packed-tarballs
# AUDITSTREAM_VERSION=0.1.0
# AUDITSTREAM_FORCE_DOWNLOAD=1
# NPM_REGISTRY=https://registry.npmjs.org/
