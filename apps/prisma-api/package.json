{
  "name": "auditstream-lab-prisma-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate deploy --config prisma.config.ts",
    "build": "prisma generate --config prisma.config.ts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/prisma-api/src/index.js"
  },
  "dependencies": {
    "@auditstream/node": "^0.2.1",
    "@auditstream/prisma": "^0.2.1",
    "@hono/node-server": "2.1.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "hono": "4.13.20",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "typescript": "~6.0.3"
  }
}
